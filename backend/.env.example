# 이 파일을 backend/.env로 복사해 값을 채운다 (backend/.env는 git에 올라가지 않는다)
# local 프로필로 실행하면 DB는 docker-compose의 로컬 DB를 쓰고, 키는 비어 있어도 웹은 뜬다(배치 수집·판별에는 키가 필요)
# DATABASE_URL=jdbc:postgresql://<host>/<db>?user=..&password=..&sslmode=require
GITHUB_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash
# 웹 전용
# FRONTEND_ORIGIN=http://localhost:3000
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# ADMIN_LOGINS=
